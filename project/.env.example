# переменные для docker compose (файл положить рядом как .env)
S2T_API_KEY=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
# email, который станет админом системы (при старте/регистрации)
ADMIN_EMAIL=
# false на публичном сервере: скрыть демо-логин с экрана входа и не сидировать demo-аккаунт
SHOW_DEMO_HINT=true
# true только при HTTPS
COOKIE_SECURE=false
