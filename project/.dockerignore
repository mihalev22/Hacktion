build

# ---------- Node — зависимости ставятся внутри контейнера ----------
node_modules
**/node_modules
frontend/node_modules
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.vite
frontend/.vite

# ---------- frontend не входит в контекст backend-образа (собирается отдельным контекстом ./frontend) ----------
frontend/
dist
frontend/dist

# ---------- секреты / env — на сервере .env создаётся отдельно ----------
.env
.env.*
backend/.env
frontend/.env

