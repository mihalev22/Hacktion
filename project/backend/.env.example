# Ключ speech2text.ru (личный кабинет -> API-ключи)
S2T_API_KEY=
# SberWave: клиентские креденшелы для GigaChat OAuth
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
# TLS Сбера идёт в self-signed цепочке. Правильный вариант — скачать корневой сертификат
# и указать путь: GIGACHAT_CA_BUNDLE=/path/sber_root_ca.pem (тогда проверка включена).
# Без него: GIGACHAT_VERIFY_SSL=false (демо-компромисс) либо true (запросы упадут).
GIGACHAT_CA_BUNDLE=
GIGACHAT_VERIFY_SSL=false
# БД (по умолчанию — абсолютный путь backend/requirex.db, задавать не нужно)
# DATABASE_URL=sqlite:////abs/path/requirex.db
# Максимум МБ на загрузку
MAX_UPLOAD_MB=200

# JWT secret: generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
# email, который получит system_role=admin (иначе — первый зарегистрированный не-demo пользователь)
ADMIN_EMAIL=
# false — скрыть демо-доступ на экране входа и не создавать demo-аккаунт
SHOW_DEMO_HINT=true
